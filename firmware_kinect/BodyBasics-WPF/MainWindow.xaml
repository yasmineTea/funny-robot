<Window x:Class="Microsoft.Samples.Kinect.BodyBasics.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ninoduino funny robot" 
        Height="600" Width="700" 
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"> 
  <Window.Resources>
    <SolidColorBrush x:Key="MediumGreyBrush" Color="#ff6e6e6e" />
    <SolidColorBrush x:Key="KinectPurpleBrush" Color="#ff52318f" />
    <SolidColorBrush x:Key="KinectBlueBrush" Color="#ff00BCF2" />
  </Window.Resources>
  <Grid Margin="10 0 10 0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Image Grid.Row="0" Source="Images\Logo.png" HorizontalAlignment="Left" Stretch="Fill" Height="32" Width="81" Margin="0 10 0 5" />
    <TextBlock Grid.Row="0" Margin="0 0 -1 0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{StaticResource MediumGreyBrush}" FontFamily="Arial Rounded MT" FontSize="18">ninoduino funny robot! </TextBlock>
    <Image Grid.Row="0" Source="Images\Status.png" Stretch="None" HorizontalAlignment="Center" Margin="0 0 0 5" />

    <Viewbox Grid.Row="1" HorizontalAlignment="Center">
      <Image Source="{Binding ImageSource}" Stretch="UniformToFill" />
    </Viewbox>
      
    <StatusBar Grid.Row="2" HorizontalAlignment="Center" Name="statusBar" VerticalAlignment="Bottom" Background="White" Foreground="{StaticResource MediumGreyBrush}">
      <StatusBarItem Content="{Binding StatusText}" />
    </StatusBar>

    <StatusBar Grid.Row="3" HorizontalAlignment="Right" Name="debugBar1" VerticalAlignment="Bottom" Background="White" Foreground="{StaticResource MediumGreyBrush}" FontSize="16">
            <TextBlock Text="R1 = "/>
            <TextBlock Name="text_R1" Text="N/A"/>
            <TextBlock Text="R2 = "/>
            <TextBlock Name="text_R2" Text="N/A"/>
            <TextBlock Text="R3 = "/>
            <TextBlock Name="text_R3" Text="N/A"/>
    </StatusBar>

        <StatusBar Grid.Row="4" HorizontalAlignment="Left" Name="debugBar2" VerticalAlignment="Bottom" Background="White" Foreground="{StaticResource MediumGreyBrush}" FontSize="16">
        <TextBlock Text="L1 = "/>
        <TextBlock Name="text_L1" Text="N/A"/>
        <TextBlock Text="L2 = "/>
        <TextBlock Name="text_L2" Text="N/A"/>
        <TextBlock Text="L3 = "/>
        <TextBlock Name="text_L3" Text="N/A"/>
    </StatusBar>

    </Grid>
</Window>
